<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="001-create-customer-reference" author="copilot">
        <createTable tableName="customer_reference">
            <column name="customer_id" type="varchar2(20)">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="credit_rating" type="varchar2(10)"/>
            <column name="risk_segment" type="varchar2(20)"/>
        </createTable>
    </changeSet>

    <changeSet id="002-create-raw-customer" author="copilot">
        <createTable tableName="raw_customer">
            <column name="customer_id" type="varchar2(20)"/>
            <column name="customer_name" type="varchar2(100)"/>
            <column name="city" type="varchar2(100)"/>
            <column name="annual_revenue" type="number"/>
        </createTable>
    </changeSet>

    <changeSet id="003-create-valid-customer" author="copilot">
        <createTable tableName="valid_customer">
            <column name="valid_customer_sk" type="number">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="customer_id" type="varchar2(20)"/>
            <column name="customer_name" type="varchar2(100)"/>
            <column name="city" type="varchar2(100)"/>
            <column name="annual_revenue" type="number"/>
            <column name="credit_rating" type="varchar2(10)"/>
            <column name="risk_segment" type="varchar2(20)"/>
            <column name="customer_status" type="varchar2(20)"/>
            <column name="load_ts" type="timestamp"/>
        </createTable>
    </changeSet>

    <changeSet id="004-create-merged-customer" author="copilot">
        <createTable tableName="merged_customer">
            <column name="merged_customer_sk" type="number">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="valid_customer_sk" type="number"/>
            <column name="customer_id" type="varchar2(20)"/>
            <column name="customer_name" type="varchar2(100)"/>
            <column name="credit_rating" type="varchar2(10)"/>
            <column name="risk_segment" type="varchar2(20)"/>
            <column name="load_ts" type="timestamp"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
